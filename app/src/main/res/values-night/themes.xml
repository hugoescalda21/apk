<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 Expressive Theme Dark Mode -->
    <style name="Base.Theme.CongregationReports" parent="Theme.Material3.DayNight">
        <!-- Primary colors for dark mode -->
        <item name="colorPrimary">#90CAF9</item>
        <item name="colorOnPrimary">#003258</item>
        <item name="colorPrimaryContainer">#004A77</item>
        <item name="colorOnPrimaryContainer">#C5E7FF</item>

        <!-- Secondary colors for dark mode -->
        <item name="colorSecondary">#FFB74D</item>
        <item name="colorOnSecondary">#4A2800</item>
        <item name="colorSecondaryContainer">#6B3C00</item>
        <item name="colorOnSecondaryContainer">#FFDDB3</item>

        <!-- Surface colors for dark mode -->
        <item name="colorSurface">#1A1C1E</item>
        <item name="colorOnSurface">#E3E2E6</item>
        <item name="colorSurfaceVariant">#42474E</item>
        <item name="colorOnSurfaceVariant">#C2C7CE</item>

        <!-- Background for dark mode -->
        <item name="android:colorBackground">#1A1C1E</item>
        <item name="colorOnBackground">#E3E2E6</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
